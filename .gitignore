# Whitelist: everything is ignored unless listed below.
# Research folders (001-*, 700-*, 800-*, ...) stay on disk but are never committed.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CITATION.cff
!/pyproject.toml
!/settings.example.ini

!/remote_work_utils/
!/pipelines/
!/configs/
!/demo/
!/research/
!/results/
!/notebook_docs/
!/tests/
!/tools/
!/geofunctions/
!/conference_slides/

# Old demo layout (kept locally, replaced by demo/0*-*.ipynb)
/demo/001-generate-analyse-dwells/
/demo/results/

# Cleaning inputs name the removed content and the local source notebooks; only the copies are published
/research/MANIFEST.yml
/research/CLEANING_REPORT.md

# Only methodology docs are published from notebook_docs/
/notebook_docs/*
!/notebook_docs/methodology/
!/notebook_docs/data_schema.md
!/notebook_docs/reproduce_paper.md

# Python / Jupyter noise
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.DS_Store
~$*

# Local outputs of demos and pipelines (regenerated by pipelines/make_demo_data.py)
/demo/output/
/demo/data/raw/
/demo/data/filtered/
/tests/_tmp/
