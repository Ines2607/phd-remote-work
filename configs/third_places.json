      "share_visits_after_home": "mean",
      "share_visits_after_work": "mean",
      "n_visits_weekday": "zero",
      "visit_frequency": "zero",
      "visit_frequency_rw": "zero",
      "n_visits_weekday_rw": "zero"
    }
  },
  "mobility": {
