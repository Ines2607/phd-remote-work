  "pu_model": {
    "target": "flag_keyword_review_rw",
    "C": 0.03,
    "l1_ratio": 0.5,
    "max_iter": 2000,
    "random_state": 42,
    "prediction_threshold": 0.5,
    "validation": {
      "holdout_frac": 0.3,
      "n_repeats": 100,
      "top_k_values": [25, 50, 100, 250],
      "C_grid": [0.03, 0.1, 0.3, 1.0],
      "l1_ratio_grid": [0.25, 0.5, 0.75],
      "top_share_step": 0.01,
      "stability_top_k": 100
    },
    "imputation": {
      "pricerange": "mean",
      "avg_dist_home": "mean",
      "avg_duration_hours_weekday": "mean",
      "share_weekday": "mean",
      "share_friday": "mean",
